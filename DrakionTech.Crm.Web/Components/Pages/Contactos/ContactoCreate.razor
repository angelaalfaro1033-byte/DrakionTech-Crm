@page "/empresas/{EmpresaId:int}/contactos/crear"
@attribute [Authorize]
@inject IContactoService ContactoService
@inject IPrefijoTelefonicoService PrefijoTelefonicoService
@inject NavigationManager Navigation
@using DrakionTech.Crm.Business.DTOs.PrefijoTelefonico

<div class="form-card">

    <div class="form-header">
        <h1>Nuevo Contacto</h1>
        <p>Completa la información del contacto</p>
    </div>

    @if (!roles.Any())
    {
        <div class="alert alert-warning">
            No hay roles configurados en el sistema.
        </div>
    }
    else
    {
        <EditForm Model="@modelo" OnValidSubmit="Guardar" FormName="CrearContactoForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control"
                           @bind-Value="modelo.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <InputText class="form-control"
                           @bind-Value="modelo.Apellido" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control"
                           @bind-Value="modelo.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <div class="input-group">
                    <PhonePrefixSelector Prefijos="prefijosTelefonicos"
                                         CodigoSeleccionado="@prefijoTelefonicoCodigo"
                                         CodigoSeleccionadoChanged="codigo => prefijoTelefonicoCodigo = codigo" />
                    <InputText class="form-control"
                               placeholder="Número"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value=this.value.replace(/\D/g,'')"
                               @bind-Value="modelo.Telefono" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Rol</label>
                <InputSelect class="form-control" @bind-Value="modelo.RolContactoId">
                    @foreach (var rol in roles)
                    {
                        <option value="@rol.Id">@rol.Nombre</option>
                    }
                </InputSelect>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary" href="/empresas/@EmpresaId/contactos">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int EmpresaId { get; set; }

    private CrearContactoDto modelo = new();
    private List<CatalogoDto> roles = new();
    private List<PrefijoTelefonicoDto> prefijosTelefonicos = new();
    private string? prefijoTelefonicoCodigo;

    protected override async Task OnInitializedAsync()
    {
        modelo.EmpresaId = EmpresaId;

        prefijosTelefonicos = (await PrefijoTelefonicoService.ObtenerTodosAsync()).ToList();
        prefijoTelefonicoCodigo = ObtenerPrefijoDefault()?.Codigo;

        roles = (await ContactoService.ObtenerRolesContactoAsync()).ToList();

        if (roles.Any())
            modelo.RolContactoId = roles.First().Id;
    }

    private async Task Guardar()
    {
        modelo.Telefono = CombinarPrefijoYNumero(prefijoTelefonicoCodigo, modelo.Telefono);
        await ContactoService.CrearAsync(modelo);
        Navigation.NavigateTo($"/empresas/{EmpresaId}/contactos");
    }

    private PrefijoTelefonicoDto? ObtenerPrefijoDefault()
        => prefijosTelefonicos.FirstOrDefault(p => p.Codigo == "+57")
            ?? prefijosTelefonicos.FirstOrDefault();

    private static string? CombinarPrefijoYNumero(string? prefijo, string? telefono)
    {
        var numero = SoloDigitos(telefono);
        if (string.IsNullOrWhiteSpace(numero))
            return null;

        return $"{prefijo}{numero}";
    }

    private static string? SoloDigitos(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return null;

        return string.Concat(valor.Where(char.IsDigit));
    }
}
