@using DrakionTech.Crm.Business.DTOs.Usuario
@using DrakionTech.Crm.Business.DTOs.RolUsuario
@using DrakionTech.Crm.Business.DTOs.PrefijoTelefonico
@inject IPrefijoTelefonicoService PrefijoTelefonicoService

<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @if (tieneErrores)
    {
        <div class="alert alert-danger py-2 mb-3">
            <ValidationSummary class="validation-summary" />
        </div>
    }

    <div class="form-section">
        <h3>Información personal</h3>
        <div class="grid-2col">
            <div class="mb-3">
                <label class="form-label">Nombre <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.Nombre" class="form-control" placeholder="Ej: María" />
                <ValidationMessage For="@(() => Model.Nombre)" class="validation-message mt-1" />
            </div>
            <div class="mb-3">
                <label class="form-label">Apellido <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.Apellido" class="form-control" placeholder="Ej: González" />
                <ValidationMessage For="@(() => Model.Apellido)" class="validation-message mt-1" />
            </div>
            <div class="mb-3">
                <label class="form-label">Correo electrónico <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.Email" class="form-control" placeholder="correo@ejemplo.com" />
                <ValidationMessage For="@(() => Model.Email)" class="validation-message mt-1" />
            </div>
            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <div class="input-group">
                    <PhonePrefixSelector Prefijos="prefijosTelefonicos"
                                         CodigoSeleccionado="@prefijoTelefonicoCodigo"
                                         CodigoSeleccionadoChanged="codigo => prefijoTelefonicoCodigo = codigo" />
                    <InputText @bind-Value="Model.Telefono"
                               class="form-control"
                               placeholder="Número"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value=this.value.replace(/\D/g,'')" />
                </div>
                <ValidationMessage For="@(() => Model.Telefono)" class="validation-message mt-1" />
            </div>
        </div>
    </div>

    <div class="form-section">
        <h3>Acceso y permisos</h3>
        <div class="mb-3">
            <label class="form-label">Rol <span class="text-danger">*</span></label>
            <InputSelect @bind-Value="Model.RolId" class="form-select">
                <option value="0">-- Selecciona un rol --</option>
                @foreach (var rol in Roles)
                {
                    <option value="@rol.Id">@rol.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.RolId)" class="validation-message mt-1" />
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            @TextoBoton
        </button>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                Cancelar
            </button>
        }
    </div>
</EditForm>

@code {
    [Parameter] public CrearUsuarioDto Model { get; set; } = new();
    [Parameter] public List<RolUsuarioDto> Roles { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string TextoBoton { get; set; } = "Guardar";

    private bool tieneErrores = false;
    private List<PrefijoTelefonicoDto> prefijosTelefonicos = new();
    private string? prefijoTelefonicoCodigo;
    private CrearUsuarioDto? modeloParseado;
    private bool prefijosCargados;

    protected override Task OnInitializedAsync()
    {
        PrepararTelefonoParaEditar();
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!prefijosCargados && Roles.Any())
        {
            prefijosTelefonicos = (await PrefijoTelefonicoService.ObtenerTodosAsync()).ToList();
            prefijosCargados = true;
        }

        if (modeloParseado is null || !ReferenceEquals(modeloParseado, Model))
            PrepararTelefonoParaEditar();
    }

    private async Task HandleValidSubmit()
    {
        Model.Telefono = CombinarPrefijoYNumero(prefijoTelefonicoCodigo, Model.Telefono);
        await OnValidSubmit.InvokeAsync();
    }

    private void PrepararTelefonoParaEditar()
    {
        if (!prefijosTelefonicos.Any())
            return;

        var telefono = SepararTelefono(Model.Telefono);
        prefijoTelefonicoCodigo = telefono.PrefijoCodigo;
        Model.Telefono = telefono.Numero;
        modeloParseado = Model;
    }

    private (string? PrefijoCodigo, string? Numero) SepararTelefono(string? telefono)
    {
        var prefijoDefault = ObtenerPrefijoDefault()?.Codigo;
        if (string.IsNullOrWhiteSpace(telefono))
            return (prefijoDefault, null);

        var prefijo = prefijosTelefonicos
            .OrderByDescending(p => p.Codigo.Length)
            .FirstOrDefault(p => telefono.StartsWith(p.Codigo, StringComparison.Ordinal));

        if (prefijo is null)
            return (prefijoDefault, SoloDigitos(telefono));

        return (prefijo.Codigo, SoloDigitos(telefono[prefijo.Codigo.Length..]));
    }

    private PrefijoTelefonicoDto? ObtenerPrefijoDefault()
        => prefijosTelefonicos.FirstOrDefault(p => p.Codigo == "+57")
            ?? prefijosTelefonicos.FirstOrDefault();

    private static string? CombinarPrefijoYNumero(string? prefijo, string? telefono)
    {
        var numero = SoloDigitos(telefono);
        if (string.IsNullOrWhiteSpace(numero))
            return null;

        return $"{prefijo}{numero}";
    }

    private static string? SoloDigitos(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return null;

        return string.Concat(valor.Where(char.IsDigit));
    }
}
